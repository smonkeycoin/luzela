import Image from "next/image";
import Link from "next/link";
import { ArrowRight, ShieldCheck, Sparkles, SunMedium, Truck } from "lucide-react";

import { PublicFooter } from "@/components/public-footer";
import { PublicHeader } from "@/components/public-header";
import { TrustBar } from "@/components/trust-bar";
import { getActiveProducts } from "@/lib/catalog/get-active-products";
import { formatMoney } from "@/lib/money";

const trustPillars = [
  {
    icon: ShieldCheck,
    title: "Protección mineral",
    copy: "Formulada para acompañarte todos los días con una sensación ligera.",
  },
  {
    icon: Truck,
    title: "Envío rastreable",
    copy: "Recibe tu pedido en México con seguimiento de entrega.",
  },
  {
    icon: SunMedium,
    title: "Uso diario",
    copy: "Acabado cómodo para playa, ciudad, familia y rutina.",
  },
];

export default async function Home() {
  const { products, error } = await getActiveProducts();

  return (
    <main className="min-h-screen">
      <PublicHeader />
      <section className="relative isolate overflow-hidden border-b border-[var(--line)]">
        <Image
          src="/luzela/hero-wide.webp"
          alt="Luzela en un contexto editorial de sol y agua"
          fill
          priority
          sizes="100vw"
          className="absolute inset-0 -z-10 object-cover opacity-18"
        />
        <div className="mx-auto grid min-h-[86vh] max-w-7xl items-center gap-10 px-5 py-14 sm:px-8 lg:grid-cols-[1.05fr_0.95fr]">
          <div className="max-w-3xl pt-10">
            <p className="mb-5 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--teal)]">
              Luzela SPF 50+
            </p>
            <h1 className="max-w-3xl text-4xl font-semibold leading-[1.05] text-[var(--ink)] sm:text-6xl">
              Protección solar mineral hecha para sentirse bien en la piel.
            </h1>
            <p className="mt-6 max-w-2xl text-base leading-8 text-[var(--muted)] sm:text-lg">
              Una fórmula ligera para usar diario, sin sensación grasosa y con
              la frescura que acompaña sol, agua y rutina.
            </p>
            <div className="mt-8 flex flex-col gap-3 sm:flex-row">
              <Link
                href="/checkout"
                className="focus-ring inline-flex h-12 items-center justify-center gap-2 bg-[var(--ink)] px-5 text-sm font-semibold text-white transition hover:bg-black"
              >
                Comprar ahora
                <ArrowRight size={18} aria-hidden />
              </Link>
              <Link
                href="https://about.luzela.mx"
                className="focus-ring inline-flex h-12 items-center justify-center gap-2 border border-[var(--ink)] px-5 text-sm font-semibold text-[var(--ink)] transition hover:bg-white"
              >
                Descubrir nuestra historia
                <ArrowRight size={18} aria-hidden />
              </Link>
            </div>
          </div>

          <div className="relative mx-auto flex w-full max-w-md items-center justify-center">
            <div className="absolute h-72 w-72 rounded-full bg-[var(--sun)]/20 blur-3xl" />
            <div className="surface relative grid aspect-[4/5] w-full place-items-center overflow-hidden rounded-[8px]">
              <Image
                src="/luzela/bottle.webp"
                alt="Producto Luzela SPF 50+"
                width={420}
                height={560}
                priority
                sizes="(max-width: 768px) 80vw, 420px"
                className="h-[82%] w-auto object-contain drop-shadow-2xl"
              />
              <div className="absolute bottom-0 left-0 right-0 border-t border-[var(--line)] bg-white/88 p-4 backdrop-blur">
                <p className="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--teal)]">
                  Luzela mineral
                </p>
                <p className="mt-1 text-sm text-[var(--muted)]">
                  Protección solar para el ritmo de México.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section className="mx-auto max-w-7xl px-5 py-6 sm:px-8">
        <TrustBar />
      </section>

      <section className="mx-auto grid max-w-7xl gap-4 px-5 py-10 sm:px-8 md:grid-cols-3">
        {trustPillars.map((pillar) => (
          <article key={pillar.title} className="surface rounded-[8px] p-5">
            <pillar.icon className="mb-5 text-[var(--coral)]" size={24} aria-hidden />
            <h2 className="text-base font-semibold text-[var(--ink)]">{pillar.title}</h2>
            <p className="mt-3 text-sm leading-6 text-[var(--muted)]">{pillar.copy}</p>
          </article>
        ))}
      </section>

      <section className="mx-auto max-w-7xl px-5 pb-14 sm:px-8">
        <div className="mb-5 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p className="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--teal)]">
              Tienda
            </p>
            <h2 className="mt-2 text-2xl font-semibold text-[var(--ink)]">
              Elige tu Luzela
            </h2>
          </div>
          {error ? (
            <p className="max-w-xl rounded-[8px] border border-[var(--line)] bg-white px-3 py-2 text-xs font-semibold text-[var(--coral)]">
              No pudimos cargar el catálogo en este momento.
            </p>
          ) : null}
        </div>

        {products.length > 0 ? (
          <div className="grid gap-4 md:grid-cols-2">
            {products.map((product) => {
              const available = product.variant.stock_on_hand > 0;

              return (
                <article key={product.id} className="surface grid gap-5 rounded-[8px] p-5 sm:grid-cols-[140px_1fr]">
                  <div className="grid aspect-square place-items-center rounded-[8px] bg-white">
                    <Image
                      src={product.image_url || "/luzela/bottle.webp"}
                      alt={product.name}
                      width={140}
                      height={140}
                      className="h-28 w-auto object-contain"
                    />
                  </div>
                  <div>
                    <div className="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                      <div>
                        <h3 className="text-lg font-semibold text-[var(--ink)]">{product.name}</h3>
                        <p className="mt-1 text-sm text-[var(--muted)]">{product.variant.name}</p>
                      </div>
                      <p className="text-lg font-semibold">
                        {formatMoney(product.variant.price_cents, product.variant.currency)}
                      </p>
                    </div>
                    <p className="mt-3 text-sm leading-6 text-[var(--muted)]">
                      {product.description || "Producto Luzela activo."}
                    </p>
                    <div className="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                      <p className={`text-sm font-semibold ${available ? "text-[var(--teal)]" : "text-[var(--coral)]"}`}>
                        {available
                          ? "Disponible"
                          : "Sin stock disponible"}
                      </p>
                      <Link
                        href={`/checkout?variant=${product.variant.id}`}
                        aria-disabled={!available}
                        className={`focus-ring inline-flex h-11 items-center justify-center gap-2 rounded-[8px] px-4 text-sm font-semibold ${
                          available
                            ? "bg-[var(--ink)] text-white"
                            : "pointer-events-none bg-zinc-300 text-zinc-600"
                        }`}
                      >
                        Comprar
                        <ArrowRight size={16} aria-hidden />
                      </Link>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        ) : (
          <div className="surface rounded-[8px] p-5 text-sm leading-6 text-[var(--muted)]">
            El catálogo no está disponible por el momento.
          </div>
        )}
      </section>

      <section className="border-y border-[var(--line)] bg-white">
        <div className="mx-auto grid max-w-7xl gap-6 px-5 py-12 sm:px-8 md:grid-cols-[1fr_1.2fr] md:items-center">
          <div>
            <p className="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--teal)]">
              Conoce Luzela
            </p>
            <h2 className="mt-3 text-2xl font-semibold text-[var(--ink)]">
              Una marca mexicana pensada para vivir mejor bajo el sol.
            </h2>
          </div>
          <div>
            <p className="text-sm leading-7 text-[var(--muted)]">
              &ldquo;No me sacó granitos y lo sentí súper fresco.&rdquo;
            </p>
            <p className="mt-2 text-sm font-semibold text-[var(--ink)]">Azu</p>
            <Link
              href="https://about.luzela.mx"
              className="focus-ring mt-5 inline-flex h-11 items-center justify-center gap-2 border border-[var(--ink)] px-4 text-sm font-semibold text-[var(--ink)]"
            >
              Descubrir nuestra historia
              <Sparkles size={16} aria-hidden />
            </Link>
          </div>
        </div>
      </section>

      <PublicFooter />
    </main>
  );
}
